# Optional: endpoint that receives lead form submissions as JSON POST
# (e.g. a Web3Forms / Formspree / n8n webhook URL). When unset, the lead
# modal shows an explicit "Demo Mode - Not Sent" state and nothing leaves
# the visitor's device.
VITE_LEAD_ENDPOINT=

# Optional: WhatsApp number (digits only, with country code) shown as the
# direct-chat fallback in the lead modal, e.g. 919876543210. When unset and
# the client profile has no number, the WhatsApp button is hidden.
VITE_DEMO_WHATSAPP=

# Optional: public scheduling link (e.g. a Cal.com booking page) shown as a
# "Book a Consultation Slot" button after the lead form. When unset, the
# button is hidden.
VITE_BOOKING_URL=
